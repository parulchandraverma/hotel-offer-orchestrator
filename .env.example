NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=hotel-offers

# Where the worker reaches the mock suppliers (served by the API process)
SUPPLIER_BASE_URL=http://localhost:3000
SUPPLIER_TIMEOUT_MS=2000

# Mock supplier behaviour: ok | fail | timeout
SUPPLIER_A_MODE=ok
SUPPLIER_B_MODE=ok
SUPPLIER_MIN_LATENCY_MS=50
SUPPLIER_MAX_LATENCY_MS=400

# Cache + stampede protection
CACHE_TTL_SECONDS=300
DEGRADED_CACHE_TTL_SECONDS=30
LOCK_TTL_MS=8000
LOCK_WAIT_MS=5000
WORKFLOW_TIMEOUT_MS=10000
