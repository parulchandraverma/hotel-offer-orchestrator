{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "description": "Hotel Offer Orchestrator - Node.js/TypeScript + Temporal + Redis. Parallel supplier fan-out, dedup, ZSET+HASH cache, degraded mode.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev:api": "npm run build && node dist/server.js",
    "dev:worker": "npm run build && node dist/worker.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "Parul Chandra",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "fastify": "^5.12.8",
    "ioredis": "^5.11.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.8",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
